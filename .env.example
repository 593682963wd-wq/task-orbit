# 默认仅发布到本机回环；外部部署须显式配置访问保护。
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
CONTAINER_PORT=8080
IMAGE_NAME=external-event-ring:local
CONTAINER_NAME=external-event-ring
# 外部访问时改为实际公开源地址与允许的Host，默认本机
PUBLIC_ORIGIN=http://127.0.0.1:8080
ALLOWED_HOSTS=127.0.0.1:8080,localhost:8080
# BASE_IMAGE可指定已批准镜像；不改宿主Docker镜像源
